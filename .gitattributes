# Normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly declare common text files
*.js        text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.xml       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.txt       text eol=lf

# Binary files: never diff or convert
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.wgt       binary
*.zip       binary
*.p12       binary
